LLM_PROVIDER=openai             # or anthropic
LLM_API_KEY=
EXTRACT_MODEL=                  # fast, low-cost model (e.g. gpt-6-luna)
REASON_MODEL=                   # stronger model for validation and Q&A (e.g. gpt-6-sol)
# LLM_DEV_CACHE=1               # optional: cache identical LLM calls in storage/llm_cache/
